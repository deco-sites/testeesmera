# Public Payload CMS origin used only by server-side loaders.
# Do not append /api; the Payload client adds it when building requests.
PAYLOAD_API_URL=https://esmeracms-green.vercel.app
# Shared secret required by the CMS publication probe (routes/api/esmera-renderability.ts).
# Must match STOREFRONT_PROBE_TOKEN configured on the CMS. Leave empty to disable the probe.
# Never commit a real value.
ESMERA_RENDERABILITY_TOKEN=
